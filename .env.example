# -----------------------------
# Database
# -----------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=StudentSpace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# -----------------------------
# Service ports (host machine)
# -----------------------------
BACKEND_PORT=8080
FRONTEND_PORT=4000

# -----------------------------
# Frontend -> Backend API URL (inside Docker network)
# -----------------------------
API_URL=http://backend:8080/api/v1
GEMINI_API_KEY=
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1,student-space.pollak.info,api-student-space.pollak.info

# -----------------------------
# Backend app config
# -----------------------------
SPRING_PROFILES_ACTIVE=docker
FRONTEND_URL=http://localhost:4000/
JWT_SECRET=change-me-to-a-long-random-secret
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000,https://student-space.pollak.info
APP_SECURITY_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api-student-space.pollak.info,student-space.pollak.info

# -----------------------------
# Mail (optional)
# -----------------------------
APP_MAIL_FROM=noreply@pollakszentes.hu
MAIL_HOST=smtp-mail.outlook.com
MAIL_PORT=587
MAIL_USERNAME=noreply@pollakszentes.hu
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# -----------------------------
# Keycloak (optional)
# -----------------------------
KEYCLOAK_CLIENT_ID=student-space
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_REDIRECT_URI=http://localhost:8080/login/oauth2/code/keycloak
KEYCLOAK_AUTHORIZATION_URI=https://keycloak.pollak.info/realms/master/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URI=https://keycloak.pollak.info/realms/master/protocol/openid-connect/token
KEYCLOAK_USERINFO_URI=https://keycloak.pollak.info/realms/master/protocol/openid-connect/userinfo
KEYCLOAK_JWK_SET_URI=https://keycloak.pollak.info/realms/master/protocol/openid-connect/certs
